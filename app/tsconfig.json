{
  "//": "Type check of the React app (npm run build). Vite builds it; this config only checks types. The logic (crm/logic/) is included for the shared data model types.",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": []
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "../crm/logic/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
