# Keys and secrets never go into git (put them in environment variables)
.env
.env.*
*.key
*token*.txt
*.pem
*.pfx
*.p12
id_rsa*
id_ed25519*

# Exports and backups of customer data
backup/
*.json
# JSON that is included despite the rule above: the npm project, the TypeScript settings and the example brand
!package.json
!package-lock.json
!crm/tsconfig.json
!app/tsconfig.json
!example/brand.json
!server/tsconfig.json

# Your company's brand (brand.json, images, extensions in extensions/) and its publish folder: never saved in git.
# Create it with  cp -r example profile  and back it up yourself.
profile/

# Local marker showing that the folder is written by an export; never goes into git
.crm-platform

# Publish folders that tools/deploy.js writes (default: <brand folder>/publish)
publish/

# The npm packages are installed with  npm ci  and never saved in git
node_modules/
# The React app's build (npm run build creates it)
app/dist/
# The REST API's build (npm run build) and the local server's database (kept in profile/data/)
server/dist/
# wrangler's local state (wrangler dev, the Cloudflare tests)
.wrangler/
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Temporary files
*.tmp
Thumbs.db
desktop.ini
