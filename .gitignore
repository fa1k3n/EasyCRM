# Nycklar och hemligheter ska aldrig in i git (lägg dem i miljövariabler)
.env
.env.*
*.key
*token*.txt
*.pem
*.pfx
*.p12
id_rsa*
id_ed25519*

# Exporter och säkerhetskopior av kunddata
backup/
*.json
# JSON som ska med trots regeln ovan: npm-projektet, TypeScript-inställningarna och exemplet på varumärke
!package.json
!package-lock.json
!kundregister/tsconfig.json
!app/tsconfig.json
!exempel/brand.json

# Ditt företags varumärke (brand.json, bilder, mailtillägg) och publiceringsmappen i den: sparas aldrig i git.
# Skapa med  Copy-Item exempel profile -Recurse  och säkerhetskopiera den själv.
profile/
varumarke/

# Lokal markering som visar att mappen skrivs av en export; följer aldrig med till git
.crm-platform

# Publiceringsmappar som tools/deploy.js skriver (standard: <varumärkesmappen>\publicera)
publicera/

# npm-paketen installeras med  npm ci  och sparas aldrig i git
node_modules/
# React-appens bygge (npm run build skapar den)
app/dist/

# Tillfälliga filer
*.tmp
Thumbs.db
desktop.ini
