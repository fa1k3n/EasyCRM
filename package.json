{
  "name": "crm",
  "private": true,
  "description": "A small CRM that runs as a claude.ai artifact. Build, test and publishing tools run on Node.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node tools/build.js && node tools/build.js --project app && node tools/build-app.js && node tools/build.js --project server && node tools/build-server.js",
    "deploy": "node tools/deploy.js",
    "preview": "node tools/preview.js",
    "serve": "npm run build && node tools/serve.js",
    "cloudflare": "npm run build && node tools/cloudflare.js",
    "test": "npm run build && jest"
  },
  "devDependencies": {
    "@babel/preset-env": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@hono/node-server": "2.1.5",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "hono": "4.13.13",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "lucide-react": "1.51.0",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "wrangler": "4.149.0"
  }
}
